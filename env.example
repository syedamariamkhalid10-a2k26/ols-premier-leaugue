# Copy to .env (or set these in your hosting dashboard)
NODE_ENV=production
PORT=3000
# Where the database, photographs and backups are stored. Must be on a persistent disk/volume.
DATA_DIR=/data
# First administrator account (only used the very first time the app starts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# Number of proxies in front of the app (Nginx / Railway / Render = 1)
TRUST_PROXY=1
# Cookies are only sent over HTTPS in production. Set to false only if testing without HTTPS.
COOKIE_SECURE=true
# Automatic backups (hours between backups, number to keep)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30
# Time zone used in reports
TZ=Asia/Karachi
